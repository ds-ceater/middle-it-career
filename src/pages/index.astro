---
// Figma: middle-it-top（PC: node 1-4 / SP: node 18-315）
// セクションと BEM の対応は docs/figma-bem-mapping.md を参照
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopMv from '@/components/top/TopMv.astro';
import TopWorry from '@/components/top/TopWorry.astro';
import TopService from '@/components/top/TopService.astro';
import TopAgeGuide from '@/components/top/TopAgeGuide.astro';
import CategorySection from '@/components/top/CategorySection.astro';
import TopAbout from '@/components/top/TopAbout.astro';

import type { ComponentProps } from 'astro/types';
import { TOPICS, articleHref, topicHref, type TopicId } from '@/lib/topics';

// トップに出すテーマ（Figma の3セクション）。タグ・記事の対応は src/lib/topics.ts で管理する
// tinted：背景色あり（Figma: job-guide / knowhow）
const TOP_SECTIONS: { id: TopicId; tinted?: boolean }[] = [
  { id: 'job-guide', tinted: true },
  { id: 'work-guide' },
  { id: 'knowhow', tinted: true },
];

const categories: ComponentProps<typeof CategorySection>[] = TOP_SECTIONS.map(({ id, tinted }) => {
  const topic = TOPICS.find((t) => t.id === id)!;
  return {
    id,
    title: topic.title,
    lead: topic.lead,
    tags: ('tags' in topic ? topic.tags : []).map((t) => ({ label: t.label, href: articleHref(t.slug) })),
    moreHref: topicHref(id),
    tinted,
  };
});
---

<BaseLayout>
  <TopMv />
  <TopWorry />
  <TopService />
  <TopAgeGuide />
  {categories.map((c) => <CategorySection {...c} />)}
  <TopAbout />
</BaseLayout>
