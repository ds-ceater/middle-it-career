---
// ステマ規制（景品表示法）対応：記事冒頭に広告である旨を明示する
interface Props {
  /** 記事以外のページで使うときは「本ページ」などに変える */
  subject?: string;
}

const { subject = '本記事' } = Astro.props;
---

{/* 目立たせすぎない灰色の小さい文字にする。ただし「広告」と分かる文言・読める大きさ・コントラスト比 4.5:1 以上は保つ（不明瞭な表示はステマ規制の対象になりうる） */}
<p class="pr-notice">
  PR：{subject}にはプロモーション（広告）が含まれています。
</p>

<style lang="scss">
  .pr-notice {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
