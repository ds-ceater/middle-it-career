---
// アフィリエイトリンクは必ずこのコンポーネント経由で出す。
// - rel="sponsored" を自動付与（Google のリンク属性ガイドライン）
// - 案件URLは src/lib/affiliates.ts で一元管理（差し替え・終了時に1か所直すだけ）
import { AFFILIATES, type AffiliateId } from '@/lib/affiliates';

interface Props {
  id: AffiliateId;
  variant?: 'text' | 'button' | 'banner';
  newTab?: boolean;
}

const { id, variant = 'text', newTab = false } = Astro.props;
const item = AFFILIATES[id];
const banner = 'banner' in item ? item.banner : undefined;
if (variant === 'banner' && !banner) {
  throw new Error(`AffiliateLink: "${id}" にはバナー画像が登録されていません（src/lib/affiliates.ts）`);
}
---

<a
  class:list={['affiliate-link', `affiliate-link--${variant}`]}
  href={item.url}
  rel={newTab ? 'sponsored noopener' : 'sponsored'}
  target={newTab ? '_blank' : undefined}
  data-affiliate-id={id}
  data-affiliate-variant={variant}
>
  {
    variant === 'banner' && banner ? (
      <img
        class="affiliate-link__banner"
        src={banner.src}
        width={banner.width}
        height={banner.height}
        alt={banner.alt}
        loading="lazy"
      />
    ) : (
      <slot>{item.label}</slot>
    )
  }
  {newTab && <span class="visually-hidden">（新しいタブで開きます）</span>}
</a>
{/* ASP 指定の計測用 1px 画像がある場合 */}
{item.pixel && <img src={item.pixel} width="1" height="1" alt="" loading="lazy" class="affiliate-link__pixel" />}

<script>
  // 広告クリックを GTM（dataLayer）に通知する。GTM 側で「affiliate_click」をトリガーに GA4 へ送る。
  // - リンクごとにリスナーを付けず document で一括で受ける（コンポーネントが何個あってもスクリプトは1回だけ読み込まれる）
  // - 成果（報酬）の計測は ASP 側が行うので、ここは「どの広告がどこでクリックされたか」の分析用
  type DataLayerWindow = Window & { dataLayer?: Record<string, unknown>[] };

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[data-affiliate-id]');
    if (!link) return;

    // ページ内で何番目の広告か（1始まり）＝記事内の位置の目安
    const links = Array.from(document.querySelectorAll('a[data-affiliate-id]'));
    // 直前の見出し（h2/h3）＝どのセクションの広告か
    const headings = Array.from(document.querySelectorAll('main h2, main h3'));
    const section = headings
      .filter((h) => h.compareDocumentPosition(link) & Node.DOCUMENT_POSITION_FOLLOWING)
      .at(-1);

    const w = window as DataLayerWindow;
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push({
      event: 'affiliate_click',
      affiliate_id: link.dataset.affiliateId,
      affiliate_variant: link.dataset.affiliateVariant,
      affiliate_position: links.indexOf(link) + 1,
      affiliate_section: section?.textContent?.trim() ?? '(冒頭)',
      page_path: location.pathname,
    });
  });
</script>

<style lang="scss">
  .affiliate-link {
    &--button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: rem(48);
      padding: var(--space-3) var(--space-8);
      font-weight: var(--font-weight-bold);
      color: #fff;
      text-decoration: none;
      background: var(--color-accent-strong); // 通常サイズの文字なので 4.5:1 を満たす濃い方
      border-radius: var(--radius-md);

      @include hover {
        filter: brightness(0.92);
      }
    }

    &--banner {
      display: block;
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
    }

    // 狭い画面では幅に合わせて縮める（比率は width/height 属性から保たれる）
    &__banner {
      display: block;
      max-width: 100%;
      height: auto;
    }

    &__pixel {
      position: absolute;
      width: 1px;
      height: 1px;
    }
  }
</style>
