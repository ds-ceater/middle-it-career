---
// Figma: mv（メインビジュアル）
// PC（xl 以上）：写真の上・左側に文字 ／ SP・タブレット：文字の下に人物が見えるよう下に余白を取る
import { Image } from 'astro:assets';
import mvImage from '@/assets/images/top-mv.png';
---

<section class="mv" aria-labelledby="mv-title">
  <Image
    class="mv__bg"
    src={mvImage}
    alt=""
    widths={[750, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="mv__body container">
    <h1 class="mv__title" id="mv-title">
      <span>40代・50代の</span><span>IT人材に、</span><span>次のキャリアを。</span>
    </h1>
    <p class="mv__lead">
      <span>これまで培った技術と経験を活かし、</span><span>あなたに合った転職先を見つけるための</span><span
        >情報をお届けします。</span
      >
    </p>
    <a class="mv__cta" href="#service">
      <span class="mv__cta-text-pc">おすすめのIT転職サービスを比較する</span>
      <span class="mv__cta-text-sp" aria-hidden="true">IT転職サービスを比較</span>
      <span aria-hidden="true">→</span>
    </a>
    <ul class="mv__guide-list">
      <li><a class="mv__guide-btn" href="#age-40">40代の転職ガイド</a></li>
      <li><a class="mv__guide-btn" href="#age-50">50代の転職ガイド</a></li>
    </ul>
  </div>
</section>

<style lang="scss">
  .mv {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-6) rem(330);
    background: linear-gradient(#cfe6f7, #a9d2f1); // 写真の上に続く空の色

    @include mq(md) {
      padding-bottom: rem(400);
    }

    @include mq(xl) {
      padding-block: rem(72) rem(120);
    }

    // 文字の読みやすさ確保のため、文字側を白く薄める
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(rgb(255 255 255 / 0.45), transparent 55%);

      @include mq(xl) {
        background: linear-gradient(90deg, rgb(255 255 255 / 0.45), transparent 60%);
      }
    }

    // SP・タブレット：写真は下寄せ・固定の高さ（人物がボタンの下に来る）。上端は背景色へフェード
    &__bg {
      position: absolute;
      inset: auto 0 0;
      z-index: -2;
      width: 100%;
      height: rem(460);
      object-fit: cover;
      object-position: 64% 100%;
      mask-image: linear-gradient(transparent, #000 30%);

      @include mq(md) {
        height: rem(540);
      }

      // PC：セクション全体に敷く
      @include mq(xl) {
        inset: 0;
        height: 100%;
        object-position: 17% 50%;
        mask-image: none;
      }
    }

    &__body {
      display: grid;
      justify-items: start;
    }

    &__title {
      font-size: #{fluid(28, 72)};
      font-weight: var(--font-weight-black);
      line-height: 1.35;
      color: var(--color-primary-dark);

      // 意味の区切りでだけ改行させる（SP：「…IT人材に、／次の…」 PC：「…50代の／IT人材に、…」）
      span {
        display: inline-block;
      }

      @include mq(md) {
        span:first-child {
          display: block;
        }
      }
    }

    &__lead {
      margin-top: #{fluid(12, 40)};
      font-size: #{fluid(15, 30)};
      font-weight: var(--font-weight-medium);
      line-height: 1.75;
      color: var(--color-text);

      span {
        display: inline-block;
      }

      @include mq(md) {
        span {
          display: block;
        }
      }
    }

    &__cta,
    &__guide-list {
      width: 100%;
      max-width: rem(784);
    }

    &__cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4em;
      min-height: #{fluid(52, 84)};
      margin-top: #{fluid(16, 48)};
      padding: var(--space-2) var(--space-6);
      // 大きい文字（19px 以上の太字）にして、--color-accent で 3:1 を確保
      font-size: #{fluid(19, 28)};
      font-weight: var(--font-weight-bold);
      line-height: 1.4;
      color: #fff;
      text-decoration: none;
      background: var(--color-accent);
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-card);
      transition: background-color 0.2s;

      @include hover {
        background: var(--color-accent-strong);
      }
    }

    // ボタン文言は PC と SP で長さが違う（Figma どおり）。読み上げは常に PC の長い方
    &__cta-text-sp {
      @include mq(md) {
        display: none;
      }
    }

    &__cta-text-pc {
      @include mq-down(md) {
        @include visually-hidden;
      }
    }

    &__guide-list {
      display: grid;
      gap: var(--space-3);
      margin-top: var(--space-3);
      padding: 0;
      list-style: none;

      @include mq(md) {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-6);
        margin-top: var(--space-8);
      }
    }

    &__guide-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: #{fluid(48, 64)};
      padding: var(--space-1) var(--space-4);
      font-size: #{fluid(17, 28)};
      font-weight: var(--font-weight-bold);
      line-height: 1.4;
      color: var(--color-primary-dark);
      text-decoration: none;
      background: rgb(245 249 255 / 0.95);
      border: 3px solid #2b5c8f;
      border-radius: var(--radius-full);
      transition: background-color 0.2s;

      @include hover {
        background: #fff;
      }
    }
  }
</style>
